cabal-version:      3.0
name:               sudoku
version:            0.1.0.0
license:            BSD-3-Clause
license-file:       LICENSE
author:             Patrick Lin
maintainer:         ptlin@uchicago.edu
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common std
    ghc-options: -Wall
    build-depends:    base, random, array, containers
    hs-source-dirs:   app
    default-language: Haskell2010

executable sudoku
    import:           std
    main-is:          Main.hs
    other-modules:    Types, Solver, Board, Candidates, Techniques.Singles, Techniques.Pairs, Techniques.Intersection

